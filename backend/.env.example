# ── Database ──────────────────────────────────────────────────────────────────
# Get from Supabase: Project → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql+asyncpg://postgres:Elevators@19993$@db.gfnafkddhhrjfhwlufwf.supabase.co:5432/postgres
SYNC_DATABASE_URL=postgresql://postgres:Elevators@19993$@db.gfnafkddhhrjfhwlufwf.supabase.co:5432/postgres
# JWT_SECRET=any-random-string
# APP_ENV=development
# ── Redis ─────────────────────────────────────────────────────────────────────
# Railway Redis plugin: copy from Variables tab
REDIS_URL=redis://default:[password]@[host]:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-here

# ── Zerodha Kite Connect ──────────────────────────────────────────────────────
# Plan: ₹500/month at developers.kite.trade
# Personal (Free) plan does NOT include market data — use Paid plan
KITE_API_KEY=
KITE_API_SECRET=

# Auto-login credentials (for daily token refresh at 08:00 IST)
KITE_USER_ID=AB1234            # Your Zerodha user ID
KITE_PASSWORD=                 # Your Zerodha login password
KITE_TOTP_SECRET=              # TOTP secret: Zerodha → My Profile → 2FA → show secret
KITE_ACCESS_TOKEN=             # Auto-filled by kite_auth.py — leave blank

# ── News ──────────────────────────────────────────────────────────────────────
# Free plan at newsapi.org (100 req/day, 24h delay)
# Developer plan ($449/mo) for real-time — RSS feeds are free fallback
NEWS_API_KEY=

# ── Telegram Alerts ───────────────────────────────────────────────────────────
# 1. Message @BotFather → /newbot → copy token
# 2. Message @userinfobot → copy your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# resend.com → free 3000 emails/month
RESEND_API_KEY=
EMAIL_FROM=alerts@yourdomain.com

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
